rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
             data.keys().size() <= 4 &&
             data.email is string && data.email.size() <= 200 &&
             data.role is string && data.role in ['admin', 'user'] &&
             (data.partnershipId == null || (data.partnershipId is string && data.partnershipId.size() <= 128)) &&
             data.createdAt == request.time;
    }

    function isValidUserUpdate(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
             data.keys().size() <= 4 &&
             data.email is string && data.email.size() <= 200 &&
             data.role is string && data.role in ['admin', 'user'] &&
             (data.partnershipId == null || (data.partnershipId is string && data.partnershipId.size() <= 128)) &&
             data.createdAt == existing().createdAt;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUserUpdate(incoming()) &&
                    (
                      incoming().diff(existing()).affectedKeys().hasOnly(['partnershipId'])
                    );
    }

    function isPartnershipAdmin(partnershipId) {
      let path = /databases/$(database)/documents/partnerships/$(partnershipId);
      return exists(path) && get(path).data.adminId == request.auth.uid;
    }

    function isPartnershipUser(partnershipId) {
      let path = /databases/$(database)/documents/partnerships/$(partnershipId);
      return exists(path) && get(path).data.userId == request.auth.uid;
    }

    function isPartnershipMember(partnershipId) {
      let path = /databases/$(database)/documents/partnerships/$(partnershipId);
      return exists(path) && (get(path).data.adminId == request.auth.uid || get(path).data.userId == request.auth.uid);
    }

    function isValidPartnership(data) {
      return data.keys().hasAll(['adminId', 'totalHearts', 'streakCount', 'createdAt']) &&
             data.keys().size() <= 7 &&
             data.adminId is string && data.adminId.size() <= 128 &&
             (data.userId == null || (data.userId is string && data.userId.size() <= 128)) &&
             data.totalHearts is number &&
             data.streakCount is number &&
             (data.get('claimedLevelRewards', null) == null || data.get('claimedLevelRewards', []) is list) &&
             data.createdAt == request.time;
    }

    function isValidPartnershipUpdate(data) {
      return data.keys().hasAll(['adminId', 'totalHearts', 'streakCount', 'createdAt']) &&
             data.keys().size() <= 7 &&
             data.adminId is string && data.adminId.size() <= 128 &&
             (data.userId == null || (data.userId is string && data.userId.size() <= 128)) &&
             data.totalHearts is number &&
             data.streakCount is number &&
             (data.get('claimedLevelRewards', null) == null || data.get('claimedLevelRewards', []) is list) &&
             data.createdAt == existing().createdAt &&
             data.adminId == existing().adminId;
    }

    match /partnerships/{partnershipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(partnershipId) &&
                    incoming().adminId == request.auth.uid &&
                    isValidPartnership(incoming());
      allow update: if isSignedIn() && (
                      (isPartnershipAdmin(partnershipId) && isValidPartnershipUpdate(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'totalHearts', 'streakCount', 'claimedLevelRewards'])) ||
                      (isPartnershipUser(partnershipId) && isValidPartnershipUpdate(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['totalHearts', 'streakCount', 'claimedLevelRewards'])) ||
                      (exists(/databases/$(database)/documents/partnerships/$(partnershipId)) &&
                       get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.userId == null &&
                       incoming().userId == request.auth.uid &&
                       isValidPartnershipUpdate(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['userId']))
                    );
      allow delete: if isSignedIn() && isPartnershipAdmin(partnershipId);
    }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'description', 'rewardHearts', 'status', 'assigneeId', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 13 &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.rewardHearts is number &&
             data.status is string && data.status in ['pending', 'completed', 'approved', 'failed'] &&
             data.assigneeId is string && data.assigneeId.size() <= 128 &&
             (data.get('reminderCount', null) == null || data.get('reminderCount', 0) is number) &&
             (data.get('reminderInterval', null) == null || (data.get('reminderInterval', '') is string && data.get('reminderInterval', '').size() <= 100)) &&
             (data.get('approvalType', null) == null || data.get('approvalType', '') in ['manual', 'automatic']) &&
             (data.get('deadline', null) == null || data.get('deadline', '') is string) &&
             (data.get('penaltyApplied', null) == null || data.get('penaltyApplied', false) is bool) &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidTaskUpdate(data) {
      return data.keys().hasAll(['title', 'description', 'rewardHearts', 'status', 'assigneeId', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 13 &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.rewardHearts is number &&
             data.status is string && data.status in ['pending', 'completed', 'approved', 'failed'] &&
             data.assigneeId is string && data.assigneeId.size() <= 128 &&
             (data.get('reminderCount', null) == null || data.get('reminderCount', 0) is number) &&
             (data.get('reminderInterval', null) == null || (data.get('reminderInterval', '') is string && data.get('reminderInterval', '').size() <= 100)) &&
             (data.get('approvalType', null) == null || data.get('approvalType', '') in ['manual', 'automatic']) &&
             (data.get('deadline', null) == null || data.get('deadline', '') is string) &&
             (data.get('penaltyApplied', null) == null || data.get('penaltyApplied', false) is bool) &&
             data.createdAt == existing().createdAt &&
             data.updatedAt == request.time;
    }

    match /partnerships/{partnershipId}/tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(partnershipId) && isValidId(taskId) &&
                    isPartnershipAdmin(partnershipId) &&
                    isValidTask(incoming());
      allow update: if isSignedIn() && isValidTaskUpdate(incoming()) &&
                    (
                      (isPartnershipAdmin(partnershipId) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'rewardHearts', 'status', 'updatedAt', 'reminderCount', 'reminderInterval', 'approvalType', 'deadline', 'penaltyApplied'])) ||
                      (isPartnershipUser(partnershipId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'penaltyApplied']) && incoming().status in ['pending', 'completed', 'approved', 'failed'])
                    );
      allow delete: if isSignedIn() && isPartnershipAdmin(partnershipId);
    }

    function isValidReward(data) {
      return data.keys().hasAll(['title', 'cost', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.title is string && data.title.size() <= 200 &&
             data.cost is number &&
             data.createdAt == request.time;
    }
    
    function isValidRewardUpdate(data) {
      return data.keys().hasAll(['title', 'cost', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.title is string && data.title.size() <= 200 &&
             data.cost is number &&
             data.createdAt == existing().createdAt;
    }

    match /partnerships/{partnershipId}/rewards/{rewardId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(partnershipId) && isValidId(rewardId) &&
                    isPartnershipAdmin(partnershipId) &&
                    isValidReward(incoming());
      allow update: if isSignedIn() && isPartnershipAdmin(partnershipId) && isValidRewardUpdate(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'cost']);
      allow delete: if isSignedIn() && isPartnershipAdmin(partnershipId);
    }

    function isValidRedemption(data) {
      return data.keys().hasAll(['rewardId', 'rewardTitle', 'cost', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 6 &&
             data.rewardId is string && data.rewardId.size() <= 128 &&
             data.rewardTitle is string && data.rewardTitle.size() <= 200 &&
             data.cost is number &&
             data.status is string && data.status in ['pending', 'fulfilled'] &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidRedemptionUpdate(data) {
      return data.keys().hasAll(['rewardId', 'rewardTitle', 'cost', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 6 &&
             data.rewardId is string && data.rewardId.size() <= 128 &&
             data.rewardTitle is string && data.rewardTitle.size() <= 200 &&
             data.cost is number &&
             data.status is string && data.status in ['pending', 'fulfilled'] &&
             data.createdAt == existing().createdAt &&
             data.updatedAt == request.time;
    }

    match /partnerships/{partnershipId}/redemptions/{redemptionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(partnershipId) && isValidId(redemptionId) &&
                    isPartnershipUser(partnershipId) &&
                    isValidRedemption(incoming());
      allow update: if isSignedIn() && isValidRedemptionUpdate(incoming()) &&
                    isPartnershipAdmin(partnershipId) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() && isPartnershipAdmin(partnershipId);
    }

    match /partnerships/{partnershipId}/dailyItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPartnershipMember(partnershipId);
    }

    match /partnerships/{partnershipId}/requests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPartnershipMember(partnershipId);
    }

    match /partnerships/{partnershipId}/dailyHistory/{historyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPartnershipMember(partnershipId);
    }
  }
}
